# Leave empty for local web development (uses the Vite dev proxy to
# http://localhost:4000, see vite.config.js).
#
# Required for production builds that are NOT served from the same origin
# as the backend -- most importantly the Capacitor Android build, which has
# no "same origin" to proxy through and must call the deployed backend
# directly over the internet.
VITE_API_URL=https://your-backend-domain.example.com
