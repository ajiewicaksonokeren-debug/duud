{
  "kind": "collectionType",
  "collectionName": "checkin_events",
  "info": { "singularName": "checkin-event", "pluralName": "checkin-events", "displayName": "Check-in Event", "description": "multiplier: nilai ×1,1–×3 · time_window: +poin di jam tertentu · challenge: +poin setelah N hari check-in" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 28 },
    "type": { "type": "enumeration", "enum": ["multiplier", "time_window", "challenge"], "required": true },
    "value": { "type": "decimal", "required": true },
    "start_at": { "type": "datetime", "required": true },
    "end_at": { "type": "datetime", "required": true },
    "window_start": { "type": "time" },
    "window_end": { "type": "time" },
    "target_days": { "type": "integer", "min": 1 },
    "segments": { "type": "string" },
    "banner": { "type": "media", "multiple": false, "allowedTypes": ["images"] }
  }
}
